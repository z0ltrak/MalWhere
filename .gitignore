# Malware samples - NEVER commit binaries. ** matches at any depth, not
# just one level down, so this also covers nested extraction output like
# samples/roning/extracted/*.bin and samples/roning/$PLUGINSDIR/*.dll --
# a one-level-deep samples/*/*.ext pattern silently missed those.
samples/**/*.exe
samples/**/*.dll
samples/**/*.bin
samples/**/*.dat
samples/**/*.vbs
samples/**/*.ps1
samples/**/*.bat
samples/**/*.zip
samples/**/*.7z
# RoningLoader's installer extraction and any dropped/decrypted payloads
# live entirely under here -- safer to ignore the whole subtree than to
# keep enumerating extensions as new artifact types get extracted.
samples/roning/

# manual_analysis/*/ holds a working copy of each sample (and, for
# RoningLoader, its NSIS-extracted files) alongside the RE report --
# never covered by the samples/ patterns above since it's a different
# directory. Found never actually committed, but only by luck (no rule
# stopped a future `git add -A`), while working through this project's
# static pipeline this session.
manual_analysis/*/*.exe
manual_analysis/*/*.dll
# RoningLoader's own encrypted-payload extension (9ZUPMq.3w) -- unique
# enough to blanket-ignore anywhere in the repo.
*.3w

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Docker volumes & secrets
docker/*/data/
docker/*/logs/
*.env.local
.secrets/

# cape-docker (celyrin/cape-docker, kvm branch) is built separately per
# docker/README.md's "Building the CAPE Image" step — never vendored here.
# It was accidentally committed once as a dangling gitlink (no .gitmodules,
# so `git clone` left it empty); ignoring it keeps that from recurring.
/cape-docker/

# CAPE runtime state under docker/cape/work — analysis output, logs, and
# CAPE's own regenerated conf/default/ boilerplate. The hand-tuned conf/*.conf
# files ARE tracked (see docker/cape/work/conf/) since they carry real
# TFM-specific setup that a fresh clone needs; only the generated/runtime
# parts are ignored here.
docker/cape/work/log/
docker/cape/work/storage/
docker/cape/work/conf/default/

# Resubmission queue: raw dropped-file bytes copied out of CAPE storage,
# same reasoning as docker/cape/work/storage/ above.
docker/resubmit_queue/

# Analysis artifacts with PII or sensitive IOCs
results/**/raw/

# Scratch/debug static-analysis reruns from iterative coverage-extension
# work (re-running after each rule batch to confirm no new false
# positives) -- real at the time, but clutter now that static/reports/
# {akira,roning,wsnake}/ hold the current canonical report each was
# re-verified against. Not part of the project's deliverable.
static/reports/*_test/
static/reports/*_test[0-9]/
static/reports/*_retest/
static/reports/*_retest[0-9]/
static/reports/diamondage_exe_retest/

# Thesis paper -- kept local-only pre-publication (source of truth is
# Overleaf); revisit once the project/thesis is published.
paper/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp

# =============================================================================
# malwhere — .env.example
# Copy this file to .env (inside docker/, next to docker-compose.yml — that's
# the only .env Compose reads) and adjust the values.
# NEVER commit .env to the repository.
# =============================================================================

# libvirt/KVM — LIBVIRT_GATEWAY and LIBVIRT_BRIDGE are NOT meant to be
# hand-filled: run scripts/host-prereqs.sh first and it discovers and writes
# both of these for you (idempotent, safe to re-run). GUEST_VM_IP is the one
# value that IS manual — set it once you've created the win10x64 guest VM.
LIBVIRT_GATEWAY=192.168.122.1
LIBVIRT_BRIDGE=virbr0
GUEST_VM_IP=

# MISP
MISP_API_KEY=changeme_generate_with_misp_ui
MISP_ADMIN_PASSWORD=Malwhere2025!

# MySQL (MISP backend)
MYSQL_ROOT_PASSWORD=malwhere_root_changeme
MYSQL_PASSWORD=malwhere_misp_changeme

# MalwareBazaar (abuse.ch) — used to source new validation samples.
# Get a key at https://bazaar.abuse.ch/account/ (needs a free account).
MALWAREBAZAAR_API_KEY=changeme_get_from_abuse_ch
